{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The scripts render components with no bundler in front of them…
    "jsx": "react-jsx",
    // …and several import `../src/lib/*.ts` by full path, as tsx resolves them.
    "allowImportingTsExtensions": true
  },
  // The scripts themselves plus the app modules they pull in. `include` is what
  // tsx consults to decide whether a file it loads is covered by this config —
  // drop `../src` and the app's .tsx compiles with the wrong JSX factory.
  "include": [
    "**/*.mts",
    "../next-env.d.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ]
}
